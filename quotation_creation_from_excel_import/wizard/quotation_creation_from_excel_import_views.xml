<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="bl_so_excel_import_view_form" model="ir.ui.view">
        <field name="name">quotation.creation.excel.import.form</field>
        <field name="model">quotation.creation.excel.import</field>
        <field name="arch" type="xml">
            <form string="Create / Update Quotation from Excel">
                <field name="state" invisible="1"/>
                <group>
                    <group>
                        <field name="partner_id"/>
                        <field name="sale_order_id" options="{'no_open':True}" invisible="1" readonly="1"/>
                        <field name="filename" invisible="1"/>
                    </group>
                    <group>
                        <field name="file" filename="filename"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                </group>

                <div invisible="state != 'preview'">
                    <div class="alert alert-danger" role="alert" invisible="error_count == 0">
                        <field name="error_count" readonly="1" class="oe_inline"/>
                        line(s) with errors.
                        Fix them, then click <b>Refresh Preview</b>.
                    </div>
                    <div class="alert alert-success" role="status" invisible="error_count != 0 or sale_order_id">
                        All lines are valid. Click <b>Create Quotation</b>.
                    </div>
                    <div class="alert alert-success" role="status" invisible="error_count != 0 or not sale_order_id">
                        All lines are valid. Click <b>Update Quotation</b>.
                    </div>

                    <field name="line_ids" nolabel="1">
                        <list create="0" delete="1" decoration-danger="has_error" editable="bottom">
                            <button name="action_open_edit_line_wizard" type="object" string="Update Product"
                                    class="btn-primary" icon="fa-pencil" display="always"/>
                            <field name="line_group_name" readonly="1" width="170px"/>
                            <field name="line_section_name" readonly="1" width="170px"/>
                            <field name="internal_ref" readonly="1" width="170px"/>
                            <field name="product_id" readonly="1" options="{'no_open': True,'no_create':True}"
                                   width="300px"/>
                            <field name="product_tmpl_id" column_invisible="1"/>
                            <field name="bom_id" options="{'no_create': True,'no_open':True}" readonly="not product_id"
                                   width="300px"/>
                            <field name="quantity" readonly="1"/>
                            <field name="price_unit" readonly="1"/>
                            <field name="subtotal" sum="Total"/>
                            <!--                            <field name="notes"/>-->
                            <field name="has_error" column_invisible="1"/>
                            <field name="message" width="300px;" readonly="1"/>
                        </list>
                    </field>
                </div>

                <footer>
                    <button name="action_preview" type="object" string="Preview"
                            class="btn-primary" invisible="state == 'preview'"/>
                    <button name="action_create_quotation" type="object" string="Create Quotation"
                            class="btn-primary" invisible="state != 'preview' or error_count or sale_order_id"/>
                    <button name="action_update_quotation" type="object" string="Update Quotation" confirm="Are you sure? Because updating the quotation will delete the existing sale order lines" class="btn-primary"
                            invisible="state != 'preview' or not sale_order_id or error_count"/>
                    <button name="action_preview" type="object" string="Refresh Preview"
                            class="btn-secondary" invisible="state != 'preview'"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>


    <record id="quotation_creation_excel_import_line_view_from_editable" model="ir.ui.view">
        <field name="name">quotation.creation.excel.import.line.form.editable</field>
        <field name="model">quotation.creation.excel.import.line</field>
        <field name="arch" type="xml">
            <form string="">
                <div class="alert alert-warning" role="alert">
                    ⚠️ Attention: Only the product with kit bom are visible.
                </div>
                <group>
                    <field name="message" class="text-danger" readonly="1"/>

                    <field name="product_id" domain="[('bom_ids', '!=', False)]"
                           options="{'no_create': True,'no_open':True}"/>
                    <field name="bom_id" domain="[('product_id', '=', product_id)]"
                           options="{'no_create': True,'no_open':True}"/>
                </group>
                <footer>
                    <button name="action_done" icon="fa-check-circle" string="Update" type="object"
                            class="btn btn-success"/>
                    <button name="action_custom_cancel" icon="fa-arrow-circle-left" string="Go Back" type="object"
                            class="btn btn-secondary"/>

                </footer>
            </form>
        </field>
    </record>

    <record id="wizard_line_update_action" model="ir.actions.act_window">
        <field name="name">Update Line</field>
        <field name="res_model">quotation.creation.excel.import.line</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="quotation_creation_excel_import_line_view_from_editable"/>
        <field name="target">new</field>
    </record>


    <record id="sale_order_excel_import_action" model="ir.actions.act_window">
        <field name="name">Create / Update Quotation from Excel</field>
        <field name="res_model">quotation.creation.excel.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>


</odoo>
