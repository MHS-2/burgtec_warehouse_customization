<?xml version="1.0" encoding="utf-8"?>
  <odoo>
      
    <!-- View account.move form -->
    <record id="burgtec_warehouse_customization_view_account_move_form" model="ir.ui.view">
        <field name="name">burgtec.warehouse.customization.view.account.move.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>

        <!-- <field name="inherit_id" ref="stock_landed_costs.account_view_move_form_inherited"/> -->
        <field name="arch" type="xml">
            <xpath expr="//button[@name='button_create_landed_costs']" position="attributes">
              <attribute name="confirm">Are you sure? Make sure that all avaialble receipts for this bill's Purchase Order's are validated. !</attribute>
              <attribute name="invisible">not landed_costs_visible or is_only_landed_cost_bill</attribute>
            </xpath>

            <!-- <xpath expr="//field[@name='invoice_line_ids']" position="before">
              <button name="add_landed_cost_product" type="object" string="Add Landed Cost" class="btn-primary" invisible="not is_only_landed_cost_bill"/>
            </xpath> -->

            <xpath expr="//field[@name='purchase_vendor_bill_id']" position="after">
              <field name="is_only_landed_cost_bill" invisible="move_type != 'in_invoice'" string="Only Landed Cost Bill"/>
            </xpath>

            <xpath expr="//page[@name='other_info']//group[@name='accounting_info_group']" position="inside">
              <field name="transferred_move_ids" widget="many2many_tags" readonly="1" context="{'po_bill':1}"/>
            </xpath>

            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='product_id']" position="after">
              <!-- ('id','not in',parent.transferred_move_ids), -->
              <field name="transfer_move_id" width="200px" domain="[('line_ids.purchase_line_id','!=',False),('state','=', 'draft')]" context="{'po_bill':1}" readonly="is_line_linked" column_invisible="not parent.is_only_landed_cost_bill"/>
              <button name="link_line" type="object" string="Link" class="btn-danger" confirm="Are you sure?" column_invisible="not parent.is_only_landed_cost_bill" invisible="is_line_linked"/>
            </xpath>

            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='product_id']" position="attributes">
              <attribute name="readonly" add="is_currency_exchange" separator="or"/>
              <attribute name="readonly" add="parent_move_line_id" separator="or"/>
              <attribute name="readonly" add="purchase_order_id" separator="or"/>
              <attribute name="readonly" add="is_line_linked" separator="or"/>
              <attribute name="column_invisible">parent.is_only_landed_cost_bill</attribute>
            </xpath>

            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='product_id']" position="before">
              <field name="product_id"
                  column_invisible="not parent.is_only_landed_cost_bill"
                  widget="product_label_section_and_note_field"
                  domain="[('id','in',parent.landed_cost_product_ids)]"
                  />
            </xpath>


            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='quantity']" position="attributes">
              <attribute name="readonly" add="is_currency_exchange" separator="or"/>
              <attribute name="readonly" add="parent_move_line_id" separator="or"/>
              <attribute name="readonly" add="is_line_linked" separator="or"/>
            </xpath>

            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='is_landed_costs_line']" position="attributes">
              <attribute name="readonly" add="is_currency_exchange" separator="or"/>
              <attribute name="readonly" add="parent_move_line_id" separator="or"/>
              <attribute name="readonly" add="is_line_linked" separator="or"/>
            </xpath>

            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='product_uom_id']" position="attributes">
              <attribute name="readonly" add="is_currency_exchange" separator="or"/>
              <attribute name="readonly" add="parent_move_line_id" separator="or"/>
              <attribute name="readonly" add="is_line_linked" separator="or"/>
            </xpath>

            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='price_unit']" position="attributes">
              <attribute name="readonly" add="parent_move_line_id" separator="or"/>
              <attribute name="readonly" add="is_line_linked" separator="or"/>
            </xpath>

        </field>
    </record>

  </odoo>