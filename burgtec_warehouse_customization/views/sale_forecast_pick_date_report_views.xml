<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View sale.forecast.pick.date.report View List -->
    <record id="view_sale_forecast_pick_date_report_list" model="ir.ui.view">
        <field name="name">view.sale.forecast.pick.date.report.list</field>
        <field name="model">sale.forecast.pick.date.report</field>
        <field name="arch" type="xml">
            <list create="0" delete="0">
                <field name="planned_pick_date" string="Pick Date"/>
                <field name="component_id"/>
                <field name="on_hand_qty"/>
                <field name="incoming_qty" sum="total_incoming_qty"/>
                <field name="demand_qty" sum="total_demand_qty"/>
                <field name="order_id"/>
            </list>
        </field>
    </record>

    <!-- View sale.forecast.pick.date.report search -->
    <record id="view_sale_forecast_pick_date_report_search" model="ir.ui.view">
        <field name="name">view.sale.forecast.pick.date.report.search</field>
        <field name="model">sale.forecast.pick.date.report</field>
        <field name="arch" type="xml">
            <search>
                <field name="component_id"/>
                <field name="order_id"/>
                <filter name="pick_date" string="Pick Date" date="planned_pick_date"/>
                <filter string="Component" name="group_by_component" domain="[]" context="{'group_by': 'component_id'}"/>
                <filter string="Pick Date" name="group_by_date" domain="[]" context="{'group_by': 'planned_pick_date'}"/>
            </search>
        </field>
    </record>

    <record id="view_sale_forecast_pick_date_report_graph" model="ir.ui.view">
        <field name="name">view.sale.forecast.pick.date.report.graph</field>
        <field name="model">sale.forecast.pick.date.report</field>
        <field name="arch" type="xml">
            <graph string="Sale Pick Date Analysis" type="line" sample="1">
                <!-- The timeline (X-Axis) goes here -->
                <field name="planned_pick_date" interval="day"/>
                 <field name="component_id"/>
                
                <!-- The quantitative value (Y-Axis) goes here -->
                <field name="demand_qty" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Action sale.forecast.pick.date.report -->
    <record id="action_sale_forecast_pick_date_report" model="ir.actions.act_window">
        <field name="name">Sale Forecast Pick Date Report</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sale.forecast.pick.date.report</field>
        <field name="view_mode">list,search,graph</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new Sale Forecast Pick Date Report.
            </p>
        </field>
    </record>

</odoo>
