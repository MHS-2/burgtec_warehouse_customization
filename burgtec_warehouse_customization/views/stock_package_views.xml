<?xml version="1.0" encoding="utf-8"?>
  <odoo>
      
    <!-- View stock.package form -->
    <record id="burgtec_warehouse_view_stock_package_form" model="ir.ui.view">
        <field name="name">burgtec.warehouse.view.stock.package.form</field>
        <field name="model">stock.package</field>
        <field name="inherit_id" ref="stock.stock_package_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='contained_quant_ids']" position="after">
              <div class="d-flex justify-content-end">
                  <label for="total_weight" string="Total Weight" class="fw-bold"/>
                  <field name="total_weight" class="me-1"/>
                  <span>
                    <field name="weight_uom_name" no_label="1"/>
                  </span>
              </div>
              <div class="d-flex justify-content-end">
                <label for="unit_cbm" string="Unit CBM" class="fw-bold"/>
                <field name="unit_cbm" class="me-1"/>
                <span>
                  <field name="cbm_uom_name"/>
                </span>
              </div>
              <div class="d-flex justify-content-end">
                <label for="unit_weight" string="Unit Weight" class="fw-bold"/>
                <field name="unit_weight" class="me-1"/>
                <span>
                  <field name="weight_uom_name" no_label="1"/>
                </span>
              </div>
            </xpath>

            <xpath expr="//field[@name='package_type_id']" position="attributes">
              <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='pack_date']" position="attributes">
              <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='location_id']" position="before">
              <field name="pack_date"/>
            </xpath>

            <xpath expr="//field[@name='company_id']" position="after">
              <field name="package_type_id"/>
              <label for="cbm" string="Package Type CBM" class="fw-bold"/>
              <div class="o_row">
                <field name="cbm"/>
                <span>
                  <field name="cbm_uom_name"/>
                </span>
              </div>
              <label for="base_weight" string="Package Type Weight" class="fw-bold"/>
              <div class="o_row">
                <field name="base_weight"/>
                <span>
                  <field name="weight_uom_name"/>
                </span>
              </div>
            </xpath>

            <xpath expr="//field[@name='contained_quant_ids']//list//field[@name='product_id']" position="after">
              <field name="product_weight"/>
              <field name="weight_uom_name"/>
            </xpath>
        </field>
    </record>

  </odoo>