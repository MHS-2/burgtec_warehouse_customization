<?xml version="1.0" encoding="utf-8"?>
  <odoo>
      
    <!-- View stock.valuation.adjustment.lines list -->
    <record id="burgtec_warehouse_view_stock_valuation_adjustment_lines_list" model="ir.ui.view">
        <field name="name">burgtec.warehouse.view.stock.valuation.adjustment.lines.list</field>
        <field name="model">stock.valuation.adjustment.lines</field>
        <field name="arch" type="xml">
          <list string="Valuation Adjustments" create="0" delete="0">
              <field name="cost_id"/>
              <field name="cost_line_id" readonly="1"/>
              <field name="product_id" readonly="1"/>
              <field name="weight" readonly="1" optional="hide"/>
              <field name="volume" readonly="1" optional="hide"/>
              <field name="quantity" readonly="1"/>
              <field name="currency_id" column_invisible="True"/>
              <field name="former_cost" readonly="1"/>
              <field name="final_cost" readonly="1"/>
              <field name="additional_landed_cost" sum="total_addition_landed_cost"/>
              <field name="additional_landed_cost_per_unit" sum="total_addition_landed_cost_per_unit"/>
          </list>
        </field>
    </record>

  </odoo>