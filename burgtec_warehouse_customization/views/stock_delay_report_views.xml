<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View stock.delay.report View List -->
    <record id="burgtec_warehouse_customization.view_stock_delay_report_list" model="ir.ui.view">
        <field name="name">burgtec_warehouse_customization.view.stock.delay.report.list</field>
        <field name="model">stock.delay.report</field>
        <field name="arch" type="xml">
            <list create="0" delete="0">
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- View stock.delay.report form -->
    <record id="burgtec_warehouse_customization.view_stock_delay_report_form" model="ir.ui.view">
        <field name="name">burgtec_warehouse_customization.view.stock.delay.report.form</field>
        <field name="model">stock.delay.report</field>
        <field name="arch" type="xml">
            <form string="Stock Delay Report" create="0" delete="0">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Name..." readonly="1"/>
                        </h1>
                    </div>
                    <button name="fetch_delay_report" type="object" string="Fetch Delay Report"/>
                    <notebook>
                        <page name="summary" string="Summary">
                            <field name="stock_delay_report_line_ids" readonly="1">
                                <list limit="80" editable="bottom">
                                    <field name="product_id" width="350px"/>
                                    <field name="qty_available"/>
                                    <field name="qty_to_deliver" width="150px"/>
                                    <field name="qty_to_receive" width="150px"/>
                                    <field name="sale_order_id" width="150px" widget="many2one_button"/>
                                    <field name="product_delivery_date" width="150px"/>
                                    <field name="purchase_order_id" width="150px" widget="many2one_button"/>
                                    <field name="product_arrival_date" width="150px"/>
                                    <!-- <field name="receipt_id" width="120px"/>
                                    <field name="delivery_id" width="120px"/>
                                    <field name="receipt_stock_move_id" width="150px"/>
                                    <field name="delivery_stock_move_id" width="150px"/> -->
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- View stock.delay.report search -->
    <!-- <record id="view_stock_delay_report_search" model="ir.ui.view">
        <field name="name">view.stock.delay.report.search</field>
        <field name="model">stock.delay.report</field>
        <field name="arch" type="xml">
            <search>
                <group expand="1" string="Group By">
                    <filter string="Name" name="name" domain="[]" context="{'group_by':'name'}"/>
                </group>
            </search>
        </field>
    </record> -->

    <!-- Action stock.delay.report -->
    <record id="action_stock_delay_report" model="ir.actions.act_window">
        <field name="name">Stock Delay Report</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">stock.delay.report</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new Stock Delay Report.
            </p>
        </field>
    </record>

    <menuitem id="menu_stock_delay_report" parent="stock.menu_warehouse_report" action="action_stock_delay_report" name="Stock Delay Report" sequence="9999"/>


</odoo>
