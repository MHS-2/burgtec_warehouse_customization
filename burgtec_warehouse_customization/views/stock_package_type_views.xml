<?xml version="1.0" encoding="utf-8"?>
  <odoo>
      
    <!-- View stock.package.type form -->
    <record id="burgtec_warehouse_view_stock_package_type_form" model="ir.ui.view">
        <field name="name">burgtec.warehouse.view.stock.package.type.form</field>
        <field name="model">stock.package.type</field>
        <field name="inherit_id" ref="stock.stock_package_type_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='size']" position="after">
                <label for="cbm" string="CBM"/>
                <div class="o_row" name="cbm">
                    <field name="cbm"/>
                    <span><field name="cbm_uom_name"/></span>
                </div>
            </xpath>
        </field>
    </record>

  </odoo>