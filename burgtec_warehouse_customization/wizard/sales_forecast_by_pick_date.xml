<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View sales.forecast.by.pick.date form -->
    <record id="view_sales_forecast_by_pick_date_form" model="ir.ui.view">
        <field name="name">view.sales.forecast.by.pick.date.form</field>
        <field name="model">sales.forecast.by.pick.date</field>
        <field name="arch" type="xml">
            <form string="Sales Forecast By Pick Date">
                <group>
                    <group>
                        <field name="date_from"/>
                    </group>
                    <group>
                        <field name="date_to"/>
                    </group>
                </group>
                <footer>
                    <button name="fetch_report" type="object" string="Fetch Report" class="oe_highlight"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action sales.forecast.by.pick.date -->
    <record id="action_sales_forecast_by_pick_date" model="ir.actions.act_window">
        <field name="name">Sales Forecast By Pick Date</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sales.forecast.by.pick.date</field>
        <field name="view_mode">form</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="target">new</field>
    </record>

    <menuitem id="root_menu_sales_forecast_by_pick_date" parent="sale.menu_sale_report" action="action_sales_forecast_by_pick_date" name="Product Forecast By Pickup Date" sequence="9999"/>




</odoo>
